<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:text="Guess The Number"
            android:textColor="#1A202C"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Score & Timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtScore"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Score: 0"
                android:textColor="#2D3748"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTimer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Time: 0s"
                android:textColor="#E53E3E"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Attempts -->
        <TextView
            android:id="@+id/txtAttempts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Attempts: -"
            android:textColor="#2D3748"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Difficulty Spinner -->
        <Spinner
            android:id="@+id/spinnerDifficulty"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:minHeight="48dp" />

        <!-- Guess Input -->
        <EditText
            android:id="@+id/editNum"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:enabled="false"
            android:hint="Enter your guess"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:textAlignment="center"
            android:textColor="#1A202C"
            android:textColorHint="#A0AEC0"
            android:textSize="18sp" />

        <!-- Start Game Button -->
        <Button
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#3182CE"
            android:text="Start Game"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Info Text -->
        <TextView
            android:id="@+id/txtInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Click Start Game to begin"
            android:textColor="#4A5568"
            android:textSize="16sp" />

        <!-- Profile Button -->
        <Button
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#4A5568"
            android:text="Profile"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#E53E3E"
            android:text="Logout"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>